# Firebase (ixtiyoriy). Bularsiz ilova to'liq ishlaydi, faqat login/cloud
# sync bo'lmaydi. Qiymatlarni Firebase Console > Project settings > Your
# apps > Web app > SDK setup and configuration'dan oling.
# O'rnatish qadamlari uchun README.md dagi "Firebase sozlash" bo'limiga qarang.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
