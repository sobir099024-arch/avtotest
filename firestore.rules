rules_version = '2';

// Each signed-in user can only read/write their own progress data, under
// users/{their-uid}/attempts/{ticket-or-category-key}. Nothing else is
// readable or writable by clients.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/attempts/{attemptKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
